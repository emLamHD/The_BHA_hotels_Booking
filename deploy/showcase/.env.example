# Copy to .env (gitignored) and replace every <placeholder>. Nothing here is a real secret.
SHOWCASE_DB=<database name, must contain "showcase" or "demo", e.g. thebha_showcase_demo>
SHOWCASE_DB_USER=<database role>
SHOWCASE_DB_PASSWORD=<generate a long random value>
SHOWCASE_DB_PORT=55432

# Origins the browser uses for the two frontends (exact scheme://host[:port], no wildcard).
CUSTOMER_ORIGIN=https://localhost:3000
ADMIN_ORIGIN=https://localhost:3001

# Locally trusted certificate and key for the proxy (absolute paths on this machine).
SHOWCASE_TLS_CERT=<absolute path to localhost.pem>
SHOWCASE_TLS_KEY=<absolute path to localhost-key.pem>
SHOWCASE_API_HTTPS_PORT=7443
