# Base URL of TheBha.Api, used by the shared Axios client (src/lib/api).
# HTTPS-ONLY: must be an absolute https:// URL (no trailing slash required —
# it is normalized either way). The API redirects http to https globally, and
# browsers do not reliably follow that redirect for a credentialed CORS
# preflight, so an http:// base is rejected outright. See README.md.
NEXT_PUBLIC_API_BASE_URL=https://localhost:7145

# OPTIONAL, server-side (not NEXT_PUBLIC): same-origin API proxy (BHA-WEB-PROXY-001). Leave EMPTY for
# local development — the browser then calls NEXT_PUBLIC_API_BASE_URL directly, as above.
# When set, Next rewrites /api/* to this upstream, so NEXT_PUBLIC_API_BASE_URL must be the CUSTOMER's own
# https origin (not the API) and the API's cookies stay first-party. Bare https origin only: no
# credentials, path, query or fragment; it must not equal the Customer origin. It is read when Next
# loads next.config.js (build time on Vercel) — rebuild after changing it. See README.md.
API_PROXY_ORIGIN=

# SERVER-SIDE (not NEXT_PUBLIC): the PUBLIC origin of THIS site, e.g. https://www.thebha.vn — the one setting the Blog's canonical
# links, hreflang, Open Graph, JSON-LD urls, /sitemap.xml and /robots.txt are built from (BHA-BLOG-001-CP05). A bare origin only: no
# path, query or credentials; https (http only for localhost). It is never guessed from a request. When it is empty or invalid those
# links are omitted, /sitemap.xml answers 500 and robots.txt names no sitemap. It is read at runtime (no rebuild to change it).
SITE_URL=
