# PMS-CAL-001.1: Admin API base URL for the Reservation Board.
# Must be an https:// URL — plain http:// (including http://localhost) is
# rejected by src/lib/api/env.ts. Matches the backend's "https" launch
# profile (Back_End/src/TheBha.Api/Properties/launchSettings.json).
NEXT_PUBLIC_API_BASE_URL=https://localhost:7145
# Deployed: the API's https:// origin on the same registrable domain as this site
# (Staff cookie is SameSite=Strict); see docs/runbooks/CUST-WEB-SHOWCASE-001-deploy.md.

# PMS-ADMIN-AUTH-001-CP06/CP07: how /calendar reaches the Admin API.
#   Staff (default when unset) — Staff sign-in at /signin; the session cookie
#                                is sent with every Calendar request.
#   LocalGate                  — local development only: no Staff sign-in; reads
#                                and writes need the backend's local Development
#                                opt-in. Refused in a production build.
# Must be exactly Staff or LocalGate. An empty or other value is a configuration
# error and /calendar sends no request — leave the line commented out rather
# than empty. Read at build time: rebuild/restart `next` after changing it.
# Must match the backend's AdminCalendar:AccessMode. No secret belongs here.
# NEXT_PUBLIC_ADMIN_CALENDAR_ACCESS_MODE=LocalGate
