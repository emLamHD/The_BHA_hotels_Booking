# PMS-CAL-001.1: Admin API base URL for the Reservation Board.
# Must be an https:// URL — plain http:// (including http://localhost) is
# rejected by src/lib/api/env.ts. Matches the backend's "https" launch
# profile (Back_End/src/TheBha.Api/Properties/launchSettings.json).
NEXT_PUBLIC_API_BASE_URL=https://localhost:7145
