<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheBha.Domain\TheBha.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The message catalog and the built-in language packs are data files, not code: a language is added by a file. -->
    <EmbeddedResource Include="Website\Localization\**\*.json" LogicalName="bha-localization/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
